# Configuration files with sensitive data
.contextlake.ini
.contextlake.kb.toml

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Packaging / build artifacts
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/

# Test / lint caches
.pytest_cache/
.ruff_cache/
# hypothesis caches its downloaded unicode tables and its failing-example
# database here. Untracked but unignored meant one `git add -A` away from
# committing ~1 MB of generated data.
.hypothesis/
.coverage
htmlcov/
coverage.xml

# IDE
# .vscode/
.idea/

# Local project planning notes (may reference private data — never published)
.notes/

# Local end-to-end testing sandbox: cloned public repos + isolated contextlake store.
# Never committed (transient test data, can be large).
playground/

# Claude Code session state: agent worktrees, job scratch dirs. Local only.
.claude/

# superpowers:subagent-driven-development plan workspaces (task briefs, review
# packages, progress ledger). Self-cleaning, but must never enter git history.
.superpowers/

# Generated docs-site pages. `site/build_docs.py` writes one .html per PAGES entry and
# prunes the rest, so committing them means every docs edit carries a rebuilt page in its
# diff -- and a `git add -A` silently adds thirty of them. Two files here are NOT generated
# and stay tracked: index.html (the hand-maintained landing page, which build_docs only
# preserves) and graph-embed.html.
site/*.html
!site/index.html
!site/graph-embed.html
