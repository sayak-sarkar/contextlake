{
  "name": "contextlake",
  // Deliberately NOT built from the repo's own Dockerfile: that image bakes
  // in the [kb,kb-local,llm-local] extras plus pinned CPU models for a
  // turnkey offline `docker run`, which is the wrong shape for day-to-day
  // editing (slow rebuilds, no dev tools) -- and it's being restructured into
  // multi-stage by a separate in-flight task, so pointing this at a build
  // stage of it would be a moving target. A plain upstream Python image plus
  // `make install` has zero coupling to that work and needs no changes when
  // it lands. Verified this image's base (buildpack-deps, via
  // docker-library/python's own Dockerfile) installs `make`, so
  // postCreateCommand below can rely on it.
  "image": "mcr.microsoft.com/devcontainers/python:3.12",

  "postCreateCommand": "make install",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python",
        "editor.formatOnSave": false
      }
    }
  }

  // Not included: a `glab` (GitLab CLI) feature. The base image ships `git`,
  // which is all the test suite needs (CONTRIBUTING.md: "No network in
  // tests" -- everything that shells out to git/glab is faked). `glab` is
  // only needed to exercise the tool against real GitLab, and no verified
  // devcontainer feature for it was found; install it manually per
  // https://gitlab.com/gitlab-org/cli if you need that.
}
